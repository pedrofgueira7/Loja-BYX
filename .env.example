# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).
# Todas opcionais. Sem IDs, nenhum script de rastreamento é carregado.

# URL pública do site (canonical, sitemap, Open Graph). Ex.: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
